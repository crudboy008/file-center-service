{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:java-card-service:rag:document-ingestion-acceptance:1.0",
  "title": "RAG to Java document ingestion acceptance event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "status",
    "operation_id",
    "document_id",
    "decided_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_type": {
      "const": "document_ingestion_acceptance"
    },
    "status": {
      "enum": ["ACCEPTED", "REJECTED", "CONFLICT"]
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "document_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{32}$",
      "x-utf8-max-bytes": 64
    },
    "task_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "rejection_code": {
      "enum": [
        "DOCUMENT_ID_ALREADY_REGISTERED",
        "INGRESS_FROZEN",
        "CURRENT_GENERATION_UNAVAILABLE"
      ]
    },
    "stored_event_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "incoming_event_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "decided_at": {
      "type": "string",
      "format": "date-time",
      "x-max-fractional-second-digits": 6
    }
  },
  "oneOf": [
    {
      "properties": {
        "status": {"const": "ACCEPTED"}
      },
      "required": ["task_id"],
      "not": {
        "anyOf": [
          {"required": ["rejection_code"]},
          {"required": ["stored_event_hash"]},
          {"required": ["incoming_event_hash"]}
        ]
      }
    },
    {
      "properties": {
        "status": {"const": "REJECTED"}
      },
      "required": ["rejection_code"],
      "not": {
        "anyOf": [
          {"required": ["task_id"]},
          {"required": ["stored_event_hash"]},
          {"required": ["incoming_event_hash"]}
        ]
      }
    },
    {
      "properties": {
        "status": {"const": "CONFLICT"}
      },
      "required": ["stored_event_hash", "incoming_event_hash"],
      "not": {
        "anyOf": [
          {"required": ["task_id"]},
          {"required": ["rejection_code"]}
        ]
      }
    }
  ]
}
